{
  "name": "typed-xlsx-examples",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./showcase/*": "./showcase/*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
