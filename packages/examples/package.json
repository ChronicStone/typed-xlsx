  },
  "dependencies": {
    "typed-xlsx": "workspace:*"
  },
  "devDependencies": {
    "@faker-js/faker": "10.6.0",
    "@types/node": "26.6.6"
  },
  "packageManager": "bun@1.3.6"
}
