{
  "name": "typed-xlsx-benchmark",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsrs --noEmit --fast && node ../../node_modules/typescript-7/bin/tsc --noEmit",
    "build": "bun run ./scripts/benchmark-stream.ts && bun run ./scripts/generate-streaming-fulfillment-sample.ts",
    "benchmark:stream": "bun run ./scripts/benchmark-stream.ts",
    "sample:streaming-fulfillment-export": "bun run ./scripts/generate-streaming-fulfillment-sample.ts",
    "report:stream": "bun run ./scripts/benchmark-stream.ts",
    "check": "tsrs --noEmit --fast && node ../../node_modules/typescript-7/bin/tsc --noEmit"
  },
  "dependencies": {
    "typed-xlsx": "workspace:*",
    "typed-xlsx-examples": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "26.6.6"
  },
  "packageManager": "bun@1.3.6"
}
