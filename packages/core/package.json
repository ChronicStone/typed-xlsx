{
  "name": "typed-xlsx",
  "version": "4.2.2",
  "description": "Type-safe Excel (.xlsx) reports for TypeScript: typed schemas, real formulas, styles, native Excel tables and streaming exports in Node.js, Bun and Deno.",
  "keywords": [
    "bun",
    "conditional-formatting",
    "data-validation",
    "deno",
    "excel",
    "excel-export",
    "excel-formulas",
    "excel-generator",
    "excel-reporting",
    "excel-table",
    "excel-writer",
    "export-to-excel",
    "nodejs",
    "ooxml",
    "report-generator",
    "reporting",
    "schema-driven",
    "spreadsheet",
    "streaming",
    "type-safe",
    "typescript",
    "workbook",
    "xlsx",
    "xlsx-writer"
  ],
  "homepage": "https://typed-xlsx.vercel.app/",
  "bugs": "https://github.com/ChronicStone/typed-xlsx/issues",
  "license": "MIT",
  "author": "ChronicStone <cthao.pro@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/ChronicStone/typed-xlsx",
    "directory": "packages/core"
  },
  "files": [
    "build",
    "README.md"
  ],
  "type": "module",
  "main": "./build/index.js",
  "types": "./build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.js",
      "default": "./build/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vp test run",
    "report:kitchen-sink": "bun run ./scripts/generate-kitchen-sink-report.ts",
    "build": "vp pack",
    "prepack": "vp pack",
    "pack:check": "npm pack --dry-run",
    "check": "tsc --noEmit && vp test run && vp pack && npm pack --dry-run"
  },
  "dependencies": {},
  "devDependencies": {
    "@faker-js/faker": "10.6.0",
    "@types/node": "26.6.6",
    "@xmldom/xmldom": "0.9.12",
    "fflate": "0.8.3"
  }
}
