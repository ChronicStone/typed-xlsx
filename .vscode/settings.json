{
  // Formatting and linting run through Vite+ (`bun run format`, `bun run lint`) and the
  // pre-commit hook, so the editor's default formatter is off.
  "prettier.enable": false,
  "editor.formatOnSave": false,
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit",
    "source.organizeImports": "never"
  }
}
